    │   ├── cmd_system.zig         # console commands
    │   ├── cvar_system.zig        # config vars
    │   ├── file_system.zig        # asset loading, pak files
    │   ├── decl_manager.zig       # declarative asset definitions
    │   │
    │   ├── renderer/              # RenderSystem — all rl.Draw* calls live here
    │   │   ├── render_system.zig
    │   │   ├── render_world.zig
    │   │   ├── material.zig
    │   │   └── model.zig
    │   │
    │   ├── sound/                 # SoundSystem — all rl audio calls live here
    │   │   ├── snd_system.zig
    │   │   ├── snd_world.zig
    │   │   └── snd_emitter.zig
    │   │
    │   ├── input/                 # ActionMap wrapping rl.IsKeyDown etc.
    │   │   └── input.zig
    │   │
    │   ├── resource/              # texture/sound/font cache
    │   │   └── resource.zig
    │   │
    │   ├── ui/                    # in-game GUI (doom's ui/)
    │   │   ├── window.zig
    │   │   └── user_interface.zig
    │   │
    │   └── cm/                    # collision model (doom's cm/)
    │       ├── trace.zig
    │       └── clip.zig
    │
    ├── game/                      # Go's internal/game — RAYLIB-FREE enforced
    │   ├── game_local.zig         # implements the Game interface
    │   ├── entity.zig             # base entity
    │   ├── actor.zig
    │   ├── player.zig
    │   ├── weapon.zig
    │   ├── projectile.zig
    │   ├── item.zig
    │   ├── mover.zig
    │   ├── trigger.zig
