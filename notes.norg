@code shell
mygame/
├── build.zig
├── build.zig.zon
│
├── base/                          # assets, maps, configs (doom's base/)
│   ├── maps/
│   ├── materials/
│   ├── sounds/
│   └── default.cfg
│
└── src/
    ├── main.zig
    │
    ├── lib/                       # Go's pkg/ — zero game knowledge
    │   ├── math/                  # Vec2, Rect, Bounds, Plane — your types
    │   ├── containers/            # List, Pool, HashMap
    │   ├── formats/               # MapFile, TileSet — shared data formats
    │   ├── lexer.zig              # cfg/decl file parsing
    │   └── str.zig
    │
    ├── engine/                    # Go's internal/engine — raylib lives HERE only
    │   ├── common.zig             # init/shutdown, global hub
